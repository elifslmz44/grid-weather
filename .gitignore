# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# Secrets -- never commit
.env

# Cached raw & processed data (regenerated by the pipeline; keep the repo light)
data/raw/*.csv
data/raw/weather/*.json
data/raw/weather/*.csv
data/processed/*.csv
data/processed/*.parquet
